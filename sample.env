# webprogress server configuration.
# Copy this file to `.env` and fill in the values. All variables use the
# WEBPROGRESS_ prefix and are read by webprogress.config.Settings.

# --- OIDC provider (required to run the server) ---
# Client credentials issued by your OIDC provider (e.g. Authentik).
WEBPROGRESS_OIDC_CLIENT_ID=
WEBPROGRESS_OIDC_CLIENT_SECRET=
# Provider discovery document.
# Authentik example: https://auth.example.com/application/o/<app-slug>/.well-known/openid-configuration
WEBPROGRESS_OIDC_SERVER_METADATA_URL=
# Scopes requested at login (optional, this is the default).
WEBPROGRESS_OIDC_SCOPE=openid email profile

# --- Server (optional; defaults shown) ---
# Public base URL of this server. Used to build the "/auth" redirect URI, so
# "<base_url>/auth" must be registered as a redirect URI in the provider.
WEBPROGRESS_BASE_URL=http://127.0.0.1:8775
# Secret used to sign session cookies. Set a strong random value in production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
WEBPROGRESS_SESSION_SECRET=change-me
# Path to the SQLite database holding users and tokens.
WEBPROGRESS_DB_PATH=webprogress.db
# Expected seconds between a task's updates, assumed only until the server has
# observed the task's own reporting cadence (i.e. for its very first update).
# From the cadence the dashboard ages a silent task to stalled (after 2× the
# interval) then dead (after 10×). Set to 0 to disable the fallback, so a task is
# judged only once its cadence is known.
WEBPROGRESS_DEFAULT_UPDATE_INTERVAL_SECONDS=30

# --- Notifications (optional; per-user settings in the dashboard override these) ---
# These provide a server-wide DEFAULT for task completion/stall alerts. A user
# who saves their own channel in the dashboard Settings menu overrides them.
# Channel: pushover | slack | webhook | (empty = off).
WEBPROGRESS_NOTIFY_CHANNEL=
# Pushover (https://pushover.net): application API token and user/group key.
WEBPROGRESS_NOTIFY_PUSHOVER_TOKEN=
WEBPROGRESS_NOTIFY_PUSHOVER_USER=
# Slack incoming-webhook URL.
WEBPROGRESS_NOTIFY_SLACK_WEBHOOK_URL=
# Custom webhook URL; receives a JSON body {event, title, message, task}.
WEBPROGRESS_NOTIFY_WEBHOOK_URL=
# Optional extra header for the custom webhook, as "Name: Value"
# (e.g. "Authorization: Bearer <token>").
WEBPROGRESS_NOTIFY_WEBHOOK_HEADER=
# Alert when a task goes this many seconds without an update (0 = off).
WEBPROGRESS_NOTIFY_STALL_SECONDS=0
